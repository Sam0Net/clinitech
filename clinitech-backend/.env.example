# ============================================
# CLINITECH - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copia este archivo como .env para configurar variables de entorno locales

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_PASSWORD_HERE

# Seguridad JWT (Genera una clave Base64 de 32 bytes con: openssl rand -base64 32)
JWT_SECRET=YOUR_BASE64_JWT_SECRET_32_BYTES_MINIMUM
JWT_EXPIRATION_MINUTES=60

# Configuración de CORS y arranque
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BOOTSTRAP_ADMIN_USERNAME=YOUR_ADMIN_USERNAME
APP_BOOTSTRAP_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_MIN_12_CHARS
